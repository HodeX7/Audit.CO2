# Copy to .env (never commit .env). Everything works with no keys: the seed extractions are cached.

# --- Ledger (Ujjwal) ---
CR_DB_PATH=./carbonroom.db
CR_DATA_DIR=./data
CR_FACTOR_SET=           # locked factor set version for the demo period (Richa)

# --- Model provider (proposals only, never arithmetic). Any model works; see docs/features/llm.md ---
LLM_PROVIDER=nvidia      # nvidia | anthropic | openai | openrouter | ollama | openai_compatible
NVIDIA_API_KEY=          # free key from build.nvidia.com (Settings -> API Keys)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=          # for LLM_PROVIDER=openai
OPENROUTER_API_KEY=      # for LLM_PROVIDER=openrouter
# ollama needs no key (local server at http://localhost:11434/v1)
LLM_BASE_URL=            # required for openai_compatible; overrides any preset's URL
LLM_API_KEY=             # overrides the preset's key variable (optional for openai_compatible)
LLM_TEMPERATURE=         # empty = preset default (0, or not sent for anthropic/openai); "none" = never send
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # chosen by `carbonroom llm bench`; fallback nvidia/nemotron-3.5-bolt-e4b
# Per-task overrides: LLM_<PROVIDER|MODEL|BASE_URL|API_KEY|TEMPERATURE>_<TASK>; task "extract" = document extraction
# LLM_MODEL_EXTRACT=nvidia/nemotron-3.5-bolt-e4b
# LLM_PROVIDER_EXTRACT=ollama
ANTHROPIC_API_KEY=       # optional alternative provider (uses https://api.anthropic.com/v1/)
# CR_ANTHROPIC_BASE_URL=  # only to override the Anthropic endpoint (not ANTHROPIC_BASE_URL: Claude Code uses that)
CR_PROPOSER=auto         # auto (cache -> llm if a key is set -> rules) | llm | rules | replay (cache only)
CR_LLM_RPM=35            # throttle; NVIDIA's free tier allows about 40 requests/minute
CR_LLM_TIMEOUT=45        # seconds per request; free endpoints sometimes hang
CR_LLM_ATTEMPTS=3        # tries per request before auto mode falls back to the rules proposer
CR_PHRASE=off            # off | auto: let the model reword agent messages (refused if any number/id/@handle changes)
# LLM_MODEL_PHRASE=nvidia/nemotron-3.5-bolt-e4b   # a faster model just for phrasing
CR_BUDGET_TOKENS=200000  # token cap per agent per close; calls stop at the cap (fallbacks take over)
CR_BUDGET_WARN=0.8       # fraction of the cap that logs a budget_warning event
# CR_NOW=2026-11-03T18:31:00Z   # pin timestamps for a reproducible demo or tests

# --- Knowledge graph in Neo4j (start it with: docker compose -f infra/neo4j/docker-compose.yml up -d) ---
CR_GRAPH=auto            # auto (sync when Neo4j answers) | on (warn when it doesn't) | off
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=carbonroom-local   # local-only default from infra/neo4j/docker-compose.yml
NEO4J_DATABASE=neo4j

# --- Switch (Akshar) ---
SWITCH_BRIDGE_URL=       # only if we build a custom protocol agent
SWITCH_REGISTRATION_KEY=
