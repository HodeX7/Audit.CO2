CR_DB_PATH=./carbonroom.db
CR_DATA_DIR=./data
CR_FACTOR_SET=           # locked factor set version for the demo period

LLM_PROVIDER=nvidia      # nvidia (default, free) | anthropic (optional)
NVIDIA_API_KEY=          # free key from build.nvidia.com (Settings -> API Keys); used ONLY to
                         # translate loosely-phrased chat replies (carbonroom/check/nlu.py) --
                         # never for arithmetic, never required for calc/check/report to work
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=               # pick a current model from GET {NVIDIA_BASE_URL}/models

ANTHROPIC_API_KEY=       # optional alternative provider (set LLM_PROVIDER=anthropic to use it)

SWITCH_BRIDGE_URL=       # only if a custom protocol agent is built
SWITCH_REGISTRATION_KEY=
