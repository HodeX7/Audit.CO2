# Copy to .env (never commit .env). Everything works with no keys: the seed extractions are cached.

# --- Ledger (Ujjwal) ---
CR_DB_PATH=./carbonroom.db
CR_DATA_DIR=./data
CR_FACTOR_SET=           # locked factor set version for the demo period (Richa)

# --- Model provider (proposals only, never arithmetic) ---
LLM_PROVIDER=nvidia      # nvidia (default, free) | anthropic (optional)
NVIDIA_API_KEY=          # free key from build.nvidia.com (Settings -> API Keys)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=               # pick with `carbonroom llm models` + `carbonroom llm bench`; default meta/llama-3.3-70b-instruct
ANTHROPIC_API_KEY=       # optional alternative provider (uses https://api.anthropic.com/v1/)
CR_PROPOSER=auto         # auto (cache -> llm if a key is set -> rules) | llm | rules
CR_LLM_RPM=35            # throttle; NVIDIA's free tier allows about 40 requests/minute
# CR_NOW=2026-11-03T18:31:00Z   # pin timestamps for a reproducible demo or tests

# --- Switch (Akshar) ---
SWITCH_BRIDGE_URL=       # only if we build a custom protocol agent
SWITCH_REGISTRATION_KEY=
